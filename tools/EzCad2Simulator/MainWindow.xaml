<Window x:Class="EzCad2Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZCAD2 - Simulatore di test" Height="720" Width="960"
        MinHeight="600" MinWidth="760" WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="EZCAD2 SIMULATOR" FontSize="26" FontWeight="Bold" Foreground="#173B63"/>
            <TextBlock Text="Finestra di prova per verificare la ricezione dei messaggi tastiera da Voice2Laser."
                       Margin="0,4,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="STATO SIMULATORE" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                    <TextBlock x:Name="StatusText" Text="In attesa di comandi" FontSize="20"
                               FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="LastKeyText" Text="Ultimo tasto: —" Foreground="#64748B" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">
                    <TextBlock Text="FINESTRA PRONTA" Foreground="#166534" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PANNELLO DI CONTROLLO SIMULATO" FontWeight="Bold" Foreground="#35699E" FontSize="11"/>
                <UniformGrid Columns="4" Margin="0,12,0,0">
                    <Border Background="#EFF6FF" CornerRadius="7" Padding="10" Margin="3">
                        <StackPanel>
                            <TextBlock Text="ANTEPRIMA (F1)" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="PreviewState" Text="Inattiva" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="7" Padding="10" Margin="3">
                        <StackPanel>
                            <TextBlock Text="START (F2)" FontSize="10" Foreground="#92400E"/>
                            <TextBlock x:Name="StartState" Text="Non richiesto" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FEE2E2" CornerRadius="7" Padding="10" Margin="3">
                        <StackPanel>
                            <TextBlock Text="STOP (ESC)" FontSize="10" Foreground="#991B1B"/>
                            <TextBlock x:Name="StopState" Text="Non richiesto" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="7" Padding="10" Margin="3">
                        <StackPanel>
                            <TextBlock Text="MESSAGGI RICEVUTI" FontSize="10" Foreground="#64748B"/>
                            <TextBlock x:Name="MessageCountText" Text="0" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Background="#F8FAFC" CornerRadius="7" Padding="12" Margin="3,12,3,0">
                    <StackPanel>
                        <TextBlock Text="POSIZIONE SIMULATA" FontWeight="Bold" FontSize="10" Foreground="#64748B"/>
                        <TextBlock x:Name="PositionText" Text="X: 0    Y: 0" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock Text="Le frecce modificano soltanto questi valori dimostrativi." FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REGISTRO MESSAGGI WINDOWS" FontWeight="Bold" Foreground="#35699E" FontSize="11"/>
                        <TextBlock Text="Qui compaiono WM_KEYDOWN e WM_KEYUP effettivamente ricevuti dalla finestra."
                                   Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Pulisci registro" Click="ClearLog_Click"/>
                </Grid>
                <ListView x:Name="MessageLog" FontFamily="Consolas" FontSize="12">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Ora" Width="105" DisplayMemberBinding="{Binding Time}"/>
                            <GridViewColumn Header="Messaggio" Width="135" DisplayMemberBinding="{Binding Message}"/>
                            <GridViewColumn Header="Tasto" Width="140" DisplayMemberBinding="{Binding Key}"/>
                            <GridViewColumn Header="VK" Width="65" DisplayMemberBinding="{Binding VirtualKey}"/>
                            <GridViewColumn Header="Scan code" Width="90" DisplayMemberBinding="{Binding ScanCode}"/>
                            <GridViewColumn Header="Extended" Width="75" DisplayMemberBinding="{Binding Extended}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="SIMULATORE SICURO: F2 non avvia alcun laser. Nessun hardware viene controllato. Questa prova verifica i messaggi Windows, non la compatibilità interna di EZCAD2 reale."
                   Foreground="#9A3412" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>
