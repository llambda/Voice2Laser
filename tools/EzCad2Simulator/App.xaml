                    <GeometryDrawing Brush="#F5B942" Geometry="M 23,18 L 29,24 L 26,27 L 20,21 Z"/>
                    <GeometryDrawing Brush="#FF5A5F" Geometry="M 3,28 L 29,28 L 29,30 L 3,30 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
