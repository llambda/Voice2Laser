                <DrawingGroup>
                    <GeometryDrawing Brush="#17212B" Geometry="M 4,0 L 28,0 Q 32,0 32,4 L 32,28 Q 32,32 28,32 L 4,32 Q 0,32 0,28 L 0,4 Q 0,0 4,0 Z"/>
                    <GeometryDrawing Brush="#2D9CDB" Geometry="M 5,5 L 27,5 L 27,27 L 5,27 Z"/>
                    <GeometryDrawing Brush="#EAF4FF" Geometry="M 8,8 L 24,8 L 24,24 L 8,24 Z"/>
