<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EzCad2Simulator</RootNamespace>
    <!-- Voice2Laser locates the target by process name: EzCad2.exe -->
    <AssemblyName>EzCad2</AssemblyName>
  </PropertyGroup>
</Project>
