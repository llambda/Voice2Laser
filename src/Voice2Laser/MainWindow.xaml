<Window x:Class="Voice2Laser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Voice2Laser" Height="900" Width="1120" MinHeight="720" MinWidth="860"
        Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Voice2Laser" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Text="Controllo vocale offline per EZCAD2"
                       Foreground="{DynamicResource AppMutedBrush}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource AppSurfaceBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Modello Vosk italiano"
                           FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True">
                    <materialDesign:PackIcon DockPanel.Dock="Right" Width="28" Height="28"
                                             Margin="10,0,2,0" VerticalAlignment="Center"
                                             ToolTip="{Binding ModelStatusText}">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="{x:Type materialDesign:PackIcon}">
                                <Setter Property="Kind" Value="Close"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelExists}" Value="True">
                                        <Setter Property="Kind" Value="Check"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             MinHeight="34" Height="36" Padding="8,4" FontSize="12"
                             VerticalContentAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Click="Start_Click" Height="36" MinHeight="36" Padding="12,0"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryHueMidBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Microphone" Width="18" Height="18"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Avvia" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Stop_Click" Height="36" MinHeight="36" Padding="12,0"
                            Margin="6,0,0,0" VerticalContentAlignment="Center"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Stop" Width="18" Height="18"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ferma" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Status}" Foreground="#475569" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONNESSIONE EZCAD2" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <materialDesign:PackIcon Kind="Circle" Width="14" Height="14" Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EzCadConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="{Binding EzCadStatus}" Foreground="#334155"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Il controllo verifica il processo EZCAD2 e l'accessibilità della sua finestra principale."
                               Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="MODALITÀ TEST ATTIVA · nessun tasto viene inviato"
                               Foreground="#166534" FontSize="11" FontWeight="Bold" Margin="0,9,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CheckEzCad_Click"
                        Width="40" MinWidth="40" Height="36" Padding="0"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        ToolTip="Ricontrolla la connessione a EZCAD2"
                        Style="{StaticResource MaterialDesignOutlinedButton}">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="MICROFONO" FontSize="11" FontWeight="Bold" Foreground="#35699E" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                              DisplayMemberPath="Name" IsEnabled="{Binding CanSelectAudioDevice}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              MinHeight="34" Height="36" Padding="8,3" FontSize="12"
                              VerticalContentAlignment="Center"
                              materialDesign:HintAssist.Hint="Seleziona il microfono"/>
                    <Button Grid.Column="1" Click="RefreshAudioDevices_Click" Width="40" MinWidth="40" Height="36" Padding="0"
                            Margin="8,0,0,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip="Aggiorna elenco microfoni" Style="{StaticResource MaterialDesignOutlinedButton}"
                            IsEnabled="{Binding CanSelectAudioDevice}">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                    </Button>
                </Grid>
                <TextBlock Text="Puoi aggiornare l'elenco dopo aver collegato la cuffia wireless. La selezione è bloccata durante l'ascolto."
                           Foreground="#64748B" FontSize="12" Margin="0,7,0,10" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LIVELLO AUDIO IN INGRESSO" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioLevelPercent, Mode=OneWay}" Height="12"
                                     Background="#E2E8F0" Foreground="#16A34A" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <TextBlock Text="{Binding AudioLevelText}" MinWidth="150"
                                   TextAlignment="Right" Foreground="#334155" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AudioPeakText}" TextAlignment="Right"
                                   Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding AudioCalibrationHint}" Foreground="#64748B"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#EAF2FF" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="RICONOSCIMENTO IN TEMPO REALE" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                <TextBlock Text="{Binding PartialText}" FontSize="22" Foreground="#173B63" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Registro comandi riconosciuti" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding Events}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="110"/>
                        <DataGridTextColumn Header="Testo riconosciuto" Binding="{Binding Text}" Width="2*"/>
                        <DataGridTextColumn Header="Azione associata" Binding="{Binding ActionName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="6" Text="COMANDI: anteprima · start/go · stop · su · giù · destra · sinistra. Il riconoscimento vocale non sostituisce interlock e arresto di emergenza hardware."
                   Foreground="#9A3412" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>