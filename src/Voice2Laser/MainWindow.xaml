<Window x:Class="Voice2Laser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Voice2Laser" Height="680" Width="980" MinHeight="560" MinWidth="760"
        Background="#F3F5F8" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Voice2Laser" FontSize="28" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock Text="Controllo vocale offline per EZCAD2 – prototipo di riconoscimento"
                       Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Modello Vosk italiano" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True">
                        <materialDesign:PackIcon DockPanel.Dock="Right"
                                                 Kind="HelpCircle"
                                                 Width="28" Height="28"
                                                 Margin="10,0,2,0"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding ModelStatusText}">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Kind" Value="HelpCircle"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModelExists}" Value="True">
                                            <Setter Property="Kind" Value="CheckCircle"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ModelExists}" Value="False">
                                            <Setter Property="Kind" Value="CloseCircle"/>
                                            <Setter Property="Foreground" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="#475569" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Avvia ascolto" Click="Start_Click" Padding="10,6" Margin="0,0,6,0"/>
                    <Button Content="Ferma" Click="Stop_Click" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="#E8F1FC" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="RICONOSCIMENTO IN TEMPO REALE" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                <TextBlock Text="{Binding PartialText}" FontSize="22" Foreground="#173B63" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Registro comandi riconosciuti" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="110"/>
                        <DataGridTextColumn Header="Testo riconosciuto" Binding="{Binding Text}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="MODALITÀ TEST: nessun tasto viene inviato a EZCAD2. Non usare il riconoscimento vocale come sistema di sicurezza."
                   Foreground="#9A3412" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>