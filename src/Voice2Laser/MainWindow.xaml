<Window x:Class="Voice2Laser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Voice2Laser" Height="850" Width="1080" MinHeight="700" MinWidth="800"
        Background="#F3F5F8" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="142"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Voice2Laser" FontSize="28" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock Text="Controllo vocale offline per EZCAD2"
                       Foreground="#64748B" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Modello Vosk italiano" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel LastChildFill="True">
                        <materialDesign:PackIcon DockPanel.Dock="Right" Width="28" Height="28"
                                                 Margin="10,0,2,0" VerticalAlignment="Center"
                                                 ToolTip="{Binding ModelStatusText}">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Kind" Value="Close"/>
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModelExists}" Value="True">
                                            <Setter Property="Kind" Value="Check"/>
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" Padding="8"
                                 VerticalContentAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Foreground="#475569" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Click="Start_Click" Style="{StaticResource ActionButtonStyle}" Background="#2563EB">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Microphone" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Avvia ascolto" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="Stop_Click" Style="{StaticResource ActionButtonStyle}" Background="#475569" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Ferma" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="CONNESSIONE EZCAD2" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <materialDesign:PackIcon Kind="Circle" Width="14" Height="14" Margin="0,0,8,0"
                                                 VerticalAlignment="Center">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="{x:Type materialDesign:PackIcon}">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EzCadConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#16A34A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <TextBlock Text="{Binding EzCadStatus}" Foreground="#334155"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="Il controllo verifica il processo EZCAD2 e l'accessibilità della sua finestra principale. Non invia comandi né modifica la finestra attiva."
                               Foreground="#64748B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CheckEzCad_Click" Padding="12,7" Margin="12,0,0,0"
                        VerticalAlignment="Center" Background="#E2E8F0" Foreground="#1E293B">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="17" Height="17" Margin="0,0,7,0"/>
                        <TextBlock Text="Verifica"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="MICROFONO" FontSize="11" FontWeight="Bold" Foreground="#35699E" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding AudioInputDevices}" SelectedItem="{Binding SelectedAudioDevice}"
                              DisplayMemberPath="Name" IsEnabled="{Binding CanSelectAudioDevice}"
                              MinHeight="38" Padding="8" VerticalContentAlignment="Center"
                              materialDesign:HintAssist.Hint="Seleziona il microfono"/>
                    <Button Grid.Column="1" Click="RefreshAudioDevices_Click" Width="42" Height="38"
                            Margin="8,0,0,0" ToolTip="Aggiorna elenco microfoni"
                            IsEnabled="{Binding CanSelectAudioDevice}">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>
                </Grid>
                <TextBlock Text="Puoi aggiornare l'elenco dopo aver collegato la cuffia wireless. La selezione è bloccata durante l'ascolto."
                           Foreground="#64748B" FontSize="12" Margin="0,7,0,10" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LIVELLO AUDIO IN INGRESSO" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding AudioLevelPercent, Mode=OneWay}" Height="12"
                                     Background="#E2E8F0" Foreground="#16A34A" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                        <TextBlock Text="{Binding AudioLevelText}" MinWidth="150"
                                   TextAlignment="Right" Foreground="#334155" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AudioPeakText}" TextAlignment="Right"
                                   Foreground="#64748B" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding AudioCalibrationHint}" Foreground="#64748B"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Background="#E8F1FC" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="RICONOSCIMENTO IN TEMPO REALE" FontSize="11" FontWeight="Bold" Foreground="#35699E"/>
                <TextBlock Text="{Binding PartialText}" FontSize="22" Foreground="#173B63" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Registro comandi riconosciuti" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="110"/>
                        <DataGridTextColumn Header="Testo riconosciuto" Binding="{Binding Text}" Width="2*"/>
                        <DataGridTextColumn Header="Azione associata" Binding="{Binding ActionName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="6" Text="COMANDI: anteprima · start/go · stop · su · giù · destra · sinistra. Il riconoscimento vocale non sostituisce interlock e arresto di emergenza hardware."
                   Foreground="#9A3412" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,12,2,0"/>
    </Grid>
</Window>